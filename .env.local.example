# Copy to .env.local for local development.
# Both are optional — the GitHub section falls back to unauthenticated
# requests (lower rate limit) if GITHUB_API_KEY is missing.

# A GitHub personal access token (no scopes needed for public data).
# Used at build time to raise the API rate limit.
GITHUB_API_KEY = your-github-token

# GitHub username whose stats/repos are shown in the Work section.
NEXT_PUBLIC_GITHUB_USERNAME = hash3liZer
